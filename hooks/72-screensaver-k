#!/bin/sh
# Krieger screensaver overlay: patched copy of LG's screensaver QML (live Earth + clock).
echo "$(date) ran $0" >> /var/log/hook.log
SRC=/var/lib/webosbrew/screensaver-k/qml
DST=/usr/palm/applications/com.webos.app.screensaver/qml
[ -f $SRC/main.qml ] || exit 0
umount $DST 2>/dev/null
mount --bind $SRC $DST
rm -rf /mnt/lg/cmn_data/checkpoint/com.webos.app.screensaver /var/palm/jail/*/tmp/checkpoint/com.webos.app.screensaver
